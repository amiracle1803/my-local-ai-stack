{
  "1":  {"class_type": "WanVideoBlockSwap", "_meta": {"title": "BLOCK_SWAP"},
         "inputs": {"blocks_to_swap": 20, "offload_img_emb": false, "offload_txt_emb": false}},
  "2":  {"class_type": "WanVideoModelLoader", "_meta": {"title": "WAN_MODEL"},
         "inputs": {"model": "Wan2_2-TI2V-5B_fp8_e4m3fn_scaled_KJ.safetensors",
                     "base_precision": "bf16", "quantization": "disabled",
                     "load_device": "offload_device", "block_swap_args": ["1", 0]}},
  "3":  {"class_type": "LoadWanVideoT5TextEncoder", "_meta": {"title": "WAN_T5"},
         "inputs": {"model_name": "umt5-xxl-enc-bf16.safetensors",
                     "precision": "bf16", "load_device": "offload_device", "quantization": "disabled"}},
  "4":  {"class_type": "WanVideoTextEncode", "_meta": {"title": "MOTION_PROMPT"},
         "inputs": {"positive_prompt": "PATCH: [camera: slow push-in] [motion: ...] anime scene, cinematic",
                     "negative_prompt": "morphing, warping, flicker, jitter, text, watermark, low quality, deformed",
                     "t5": ["3", 0], "model_to_offload": ["2", 0], "force_offload": true,
                     "device": "cpu", "use_disk_cache": false}},
  "5":  {"class_type": "WanVideoVAELoader", "_meta": {"title": "WAN_VAE"},
         "inputs": {"model_name": "Wan2_2_VAE_bf16.safetensors", "precision": "bf16"}},
  "6":  {"class_type": "LoadImage", "_meta": {"title": "START_FRAME"},
         "inputs": {"image": "panel.png"}},
  "7":  {"class_type": "ImageResizeKJv2", "_meta": {"title": "INIT_RESIZE"},
         "inputs": {"image": ["6", 0], "width": 768, "height": 448, "upscale_method": "lanczos",
                     "keep_proportion": "crop", "pad_color": "0, 0, 0", "crop_position": "center",
                     "divisible_by": 32, "device": "cpu"}},
  "8":  {"class_type": "WanVideoEncode", "_meta": {"title": "START_ENCODE"},
          "inputs": {"vae": ["5", 0], "image": ["7", 0], "enable_vae_tiling": false,
                      "tile_x": 272, "tile_y": 272, "tile_stride_x": 144, "tile_stride_y": 128}},
  "9":  {"class_type": "WanVideoEmptyEmbeds", "_meta": {"title": "I2V_EMBEDS"},
          "inputs": {"width": 768, "height": 448, "num_frames": 81, "extra_latents": ["8", 0]}},
  "10": {"class_type": "WanVideoSampler", "_meta": {"title": "SAMPLER"},
          "inputs": {"model": ["2", 0], "image_embeds": ["9", 0], "text_embeds": ["4", 0],
                      "steps": 30, "cfg": 5.0, "shift": 5.0, "seed": 0,
                      "force_offload": true, "scheduler": "unipc", "riflex_freq_index": 0}},
  "11": {"class_type": "WanVideoDecode", "_meta": {"title": "WAN_DECODE"},
          "inputs": {"vae": ["5", 0], "samples": ["10", 0], "enable_vae_tiling": false,
                      "tile_x": 272, "tile_y": 272, "tile_stride_x": 144, "tile_stride_y": 128,
                      "normalization": "default"}},
  "13": {"class_type": "VHS_VideoCombine", "_meta": {"title": "SAVE_PREFIX"},
         "inputs": {"images": ["11", 0], "frame_rate": 16, "loop_count": 0,
                     "filename_prefix": "wan_i2v_out", "format": "video/h264-mp4",
                     "pingpong": false, "save_output": true}}
}