{
  "1":  {"class_type": "CheckpointLoaderSimple", "_meta": {"title": "CKPT_LTX"},
         "inputs": {"ckpt_name": "PATCH_LTX_CHECKPOINT.safetensors"}},
  "2":  {"class_type": "CLIPTextEncode", "_meta": {"title": "MOTION_PROMPT"},
         "inputs": {"clip": ["1", 1], "text": "PATCH: [camera: static] [motion: hair drifts gently, cloth sways] subtle ambient motion, anime scene"}},
  "3":  {"class_type": "CLIPTextEncode", "_meta": {"title": "PROMPT_NEG"},
         "inputs": {"clip": ["1", 1], "text": "morphing, warping, flicker, text, watermark, low quality"}},
  "4":  {"class_type": "LTXVConditioning", "_meta": {"title": "LTX_COND"},
         "inputs": {"positive": ["2", 0], "negative": ["3", 0], "frame_rate": 24.0}},
  "5":  {"class_type": "LoadImage", "_meta": {"title": "START_FRAME"},
         "inputs": {"image": "PATCH_START_FRAME.png"}},
  "6":  {"class_type": "LTXVImgToVideo", "_meta": {"title": "I2V"},
         "inputs": {"positive": ["4", 0], "negative": ["4", 1], "vae": ["1", 2],
                     "image": ["5", 0], "width": 768, "height": 448,
                     "length": 97, "batch_size": 1, "strength": 1.0}},
  "7":  {"class_type": "LTXVScheduler", "_meta": {"title": "SCHEDULER"},
         "inputs": {"steps": 20, "max_shift": 2.05, "base_shift": 0.95,
                     "stretch": true, "terminal": 0.1, "latent": ["6", 2]}},
  "8":  {"class_type": "KSamplerSelect", "_meta": {"title": "SAMPLER_SELECT"},
         "inputs": {"sampler_name": "euler"}},
  "9":  {"class_type": "SamplerCustom", "_meta": {"title": "SAMPLER"},
         "inputs": {"model": ["1", 0], "add_noise": true, "noise_seed": 0,
