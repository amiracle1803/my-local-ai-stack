                     "sampler": ["8", 0], "sigmas": ["7", 0], "latent_image": ["6", 2]}},
  "10": {"class_type": "VAEDecode", "_meta": {"title": "DECODE"},
         "inputs": {"samples": ["9", 0], "vae": ["1", 2]}},
  "11": {"class_type": "SaveAnimatedWEBP", "_meta": {"title": "SAVE"},
         "inputs": {"images": ["10", 0], "filename_prefix": "clip",
                     "fps": 24.0, "lossless": false, "quality": 90, "method": "default"}}
}
