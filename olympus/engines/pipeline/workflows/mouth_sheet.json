{
  "1":  {"class_type": "CheckpointLoaderSimple", "_meta": {"title": "CKPT",
         "note": "2026-07-11: defaulted to animagine-xl-4.0.safetensors (non-banned SDXL anime base) - see manifest._readme."},
         "inputs": {"ckpt_name": "animagine-xl-4.0.safetensors"}},
  "2":  {"class_type": "LoraLoader", "_meta": {"title": "LORA_CHAR",
         "note": "2026-07-11: no trained character LoRA yet - defaulted to the Hyper speed LoRA at strength 0 (harmless no-op placeholder; original design strength was 0.9 for real identity-lock, restore that once a real per-character LoRA is trained and patched in)."},
         "inputs": {"model": ["1", 0], "clip": ["1", 1],
                     "lora_name": "Hyper-SDXL-8steps-CFG-lora.safetensors",
                     "strength_model": 0.0, "strength_clip": 0.0}},
  "3":  {"class_type": "LoadImage", "_meta": {"title": "REF_IMAGE"},
         "inputs": {"image": "PATCH_FRONT_REF.png"}},
  "4":  {"class_type": "LoadImageMask", "_meta": {"title": "MASK_IMAGE"},
         "inputs": {"image": "PATCH_MOUTH_MASK.png", "channel": "red"}},
  "5":  {"class_type": "VAEEncodeForInpaint", "_meta": {"title": "INPAINT_ENCODE"},
         "inputs": {"pixels": ["3", 0], "vae": ["1", 2], "mask": ["4", 0], "grow_mask_by": 8}},
  "11": {"class_type": "CLIPTextEncode", "_meta": {"title": "VISEME_PROMPT"},
         "inputs": {"clip": ["2", 1], "text": "PATCH: same character, mouth shape only - e.g. 'mouth wide open, saying ah'"}},
  "12": {"class_type": "CLIPTextEncode", "_meta": {"title": "PROMPT_NEG"},
         "inputs": {"clip": ["2", 1], "text": "different face, changed eyes, changed hair, extra features, lowres"}},
  "14": {"class_type": "KSampler", "_meta": {"title": "SAMPLER"},
         "inputs": {"model": ["2", 0], "seed": 0, "steps": 12, "cfg": 3.0,
                     "sampler_name": "euler", "scheduler": "normal",
                     "positive": ["11", 0], "negative": ["12", 0],
                     "latent_image": ["5", 0], "denoise": 1.0}},
  "15": {"class_type": "VAEDecode", "_meta": {"title": "DECODE"},
         "inputs": {"samples": ["14", 0], "vae": ["1", 2]}},
  "16": {"class_type": "SaveImage", "_meta": {"title": "SAVE"},
         "inputs": {"images": ["15", 0], "filename_prefix": "mouth"}}
}
