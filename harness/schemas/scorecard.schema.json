{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://angelic-harness.local/schemas/scorecard.schema.json",
  "title": "Scorecard",
  "description": "Scorer rubric output at scores/scorecard-<step>.json (handoff.md §7).",
  "type": "object",
  "additionalProperties": false,
  "required": ["handoff_id", "loop", "rubric", "scores", "weighted_total", "gate"],
  "properties": {
    "handoff_id": {"type": "string"},
    "loop": {"type": "integer", "minimum": 0},
    "rubric": {"type": "string"},
    "scores": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}
    },
    "weighted_total": {"type": "number", "minimum": 0, "maximum": 1},
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["threshold", "passed"],
      "properties": {
        "threshold": {"type": "number", "minimum": 0, "maximum": 1},
        "passed": {"type": "boolean"}
      }
    }
  }
}
