# ── Model API Keys (optional — system works without these) ─────────────────────
CLAUDE_API_KEY=
PERPLEXITY_API_KEY=

# ── Obsidian vault path (optional) ─────────────────────────────────────────────
OBSIDIAN_VAULT_PATH=/home/USER/Obsidian/MainVault

# ── Privacy / Mode ─────────────────────────────────────────────────────────────
# Set to true to disable ALL remote model and search calls
LOCAL_ONLY=false

# ── Logging ────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Backend ────────────────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ── Local LLM endpoint (LM Studio / Ollama / any OpenAI-compatible server) ─────
HERMES_ENDPOINT=http://127.0.0.1:1234/v1/chat/completions
HERMES_MODEL=google/gemma-4-e4b

# ── Embedding model (LM Studio or Ollama) ──────────────────────────────────────
EMBEDDING_ENDPOINT=http://127.0.0.1:1234/v1/embeddings
EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
