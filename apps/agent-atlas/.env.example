# Copy to .env and fill in what you use. Nothing here is required --
# Agent Atlas runs fully local against Ollama with no .env at all.

# Optional remote LLM fallback (only used if Ollama/LM Studio are both down)
GROQ_API_KEY=

# Obsidian vault (matches config.json's vault_path at the repo root by default)
OBSIDIAN_VAULT_PATH=C:/Users/amire/Documents/Obsidian Vault

# Docker MCP Toolkit gateway (foundation/start-mcp-gateway.bat) -- fixed
# local token, not a real credential, just anti-DNS-rebinding. Change
# only if you changed it in the .bat script too.
MCP_GATEWAY_URL=http://127.0.0.1:8811/sse
MCP_GATEWAY_AUTH_TOKEN=agent-atlas-dev-fixed-token-12345

# Langfuse (foundation/start-langfuse.bat) -- these match the
# LANGFUSE_INIT_* values baked into docker-compose-langfuse.yml's
# headless bootstrap, so tracing works out of the box. Change both
# together if you edit the compose file.
LANGFUSE_HOST=http://localhost:3030
LANGFUSE_PUBLIC_KEY=pk-lf-agent-atlas-local-dev
LANGFUSE_SECRET_KEY=sk-lf-agent-atlas-local-dev

# Multi-account email tools -- not built in this rebuild yet.
# EMAIL_1_ADDRESS=
# EMAIL_1_IMAP_HOST=
# EMAIL_1_APP_PASSWORD=
