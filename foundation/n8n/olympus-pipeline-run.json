{
  "name": "Olympus Pipeline Run",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "olympus-pipeline-run",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook",
      "name": "Pipeline Request",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [260, 300]
    },
    {
      "parameters": {
        "url": "http://host.docker.internal:4600/api/providers",
        "options": {"timeout": 10000}
      },
      "id": "providers",
      "name": "Check Providers",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [500, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:4600/api/pipeline/{{$json.slug}}/run-all",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({step: $json.step || false}) }}",
        "options": {"timeout": 30000}
      },
      "id": "run",
      "name": "Start Pipeline",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [740, 300]
    },
    {
      "parameters": {"respondWith": "json", "responseBody": "={{ JSON.stringify($json) }}"},
      "id": "response",
      "name": "Return Run Status",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [980, 300]
    }
  ],
  "connections": {
    "Pipeline Request": {"main": [[{"node": "Check Providers", "type": "main", "index": 0}]]},
    "Check Providers": {"main": [[{"node": "Start Pipeline", "type": "main", "index": 0}]]},
    "Start Pipeline": {"main": [[{"node": "Return Run Status", "type": "main", "index": 0}]]}
  },
  "active": false,
  "settings": {},
  "versionId": "olympus-pipeline-v1",
  "meta": {"templateCredsSetupCompleted": true},
  "tags": []
}
