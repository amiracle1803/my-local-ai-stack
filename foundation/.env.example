# Copy this file to ".env" (same folder) and edit the values.
# docker compose reads it automatically.

# Your timezone (so schedules fire at the right local time).
# Find yours at https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=America/New_York

# Login for the n8n web UI at http://localhost:5678
N8N_USER=admin
N8N_PASSWORD=change-me-to-something-strong

# Optional: lets the dashboard (and Agent Atlas) read/manage workflows via
# n8n's REST API. Generate one in the n8n UI: Settings -> n8n API -> Create
# an API key, then paste it here. Leave blank to skip -- n8n itself still
# works fine without it, this only unlocks the dashboard integration.
N8N_API_KEY=
